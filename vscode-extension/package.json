{
  "name": "local-coding-agent",
  "displayName": "Yang Coding",
  "description": "Yang Coding — 로컬 코딩 모델(Rust + llama.cpp)로 자연어 채팅을 통해 코딩하는 에이전트",
  "version": "0.2.2",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "localAgentRight",
          "title": "Yang Coding",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "localAgentRight": [
        {
          "type": "webview",
          "id": "localAgent.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "localAgent.focus",
        "title": "Yang Coding: 채팅 열기"
      },
      {
        "command": "localAgent.newChat",
        "title": "Yang Coding: 새 대화",
        "icon": "$(add)"
      },
      {
        "command": "localAgent.askAboutSelection",
        "title": "Yang Coding: 선택 영역에 대해 묻기"
      },
      {
        "command": "localAgent.startBackend",
        "title": "Yang Coding: 백엔드 시작"
      },
      {
        "command": "localAgent.setAgentRoot",
        "title": "Yang Coding: AI-agent 폴더 지정"
      },
      {
        "command": "localAgent.showLog",
        "title": "Yang Coding: 작업 로그 보기",
        "icon": "$(output)"
      },
      {
        "command": "localAgent.configureRemote",
        "title": "Yang Coding: 원격 접속 설정 (Tailscale / Cloudflare)"
      },
      {
        "command": "localAgent.useLocal",
        "title": "Yang Coding: 로컬 모드로 전환"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "localAgent.showLog",
          "when": "view == localAgent.chat",
          "group": "navigation@1"
        },
        {
          "command": "localAgent.newChat",
          "when": "view == localAgent.chat",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "localAgent.askAboutSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "localAgent.focus",
        "key": "cmd+shift+l",
        "mac": "cmd+shift+l",
        "win": "ctrl+shift+l"
      }
    ],
    "configuration": {
      "title": "Yang Coding",
      "properties": {
        "localAgent.mode": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ],
          "default": "local",
          "enumDescriptions": [
            "이 PC 의 백엔드·엔진 사용",
            "Cloudflare Tunnel 로 원격 서버(맥)에 접속"
          ],
          "description": "접속 방식"
        },
        "localAgent.serverUrl": {
          "type": "string",
          "default": "",
          "description": "원격 모드 서버 주소 (예: https://agent.example.com). 토큰은 'Yang Coding: 원격 접속 설정' 명령으로 안전하게 저장"
        },
        "localAgent.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8010",
          "description": "FastAPI 백엔드 주소"
        },
        "localAgent.engineUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18091",
          "description": "Rust 추론 엔진 주소"
        },
        "localAgent.agentRoot": {
          "type": "string",
          "default": "",
          "description": "AI-agent 프로젝트 폴더 (백엔드 자동 실행에 사용)"
        },
        "localAgent.autoStartBackend": {
          "type": "boolean",
          "default": true,
          "description": "백엔드가 꺼져 있으면 자동 실행"
        },
        "localAgent.approveEdits": {
          "type": "string",
          "enum": [
            "auto",
            "ask"
          ],
          "default": "auto",
          "description": "파일 수정 승인 방식 (auto 여도 대화별 되돌리기 가능)"
        },
        "localAgent.approveCommands": {
          "type": "string",
          "enum": [
            "ask",
            "auto"
          ],
          "default": "ask",
          "description": "터미널 명령 실행 승인 방식"
        },
        "localAgent.maxSteps": {
          "type": "number",
          "default": 16,
          "description": "한 요청에서 도구 호출 최대 반복 수"
        },
        "localAgent.maxTokens": {
          "type": "number",
          "default": 4096,
          "description": "응답 1회 최대 토큰"
        },
        "localAgent.temperature": {
          "type": "number",
          "default": 0.2
        },
        "localAgent.showLogOnRequest": {
          "type": "boolean",
          "default": true,
          "description": "요청을 보낼 때 작업 로그 콘솔(출력 패널)을 자동으로 표시"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "~5.8.3"
  }
}
