<idea-plugin>
  <id>com.localagent.coding</id>
  <name>Yang Coding</name>
  <vendor>local</vendor>
  <description><![CDATA[
    Local coding agent chat powered by an on-device model (Rust + llama.cpp).<br/>
    로컬 코딩 모델(Rust + llama.cpp)로 자연어 채팅을 통해 코딩하는 에이전트.
    파일 읽기/수정, 명령 실행(승인), 선호·제약 저장, 요구사항 하네스, 모델 관리를 지원합니다.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Yang Coding" anchor="right" icon="/icons/agent.svg"
                factoryClass="com.localagent.ChatToolWindowFactory"/>
    <toolWindow id="Yang Coding 로그" anchor="bottom" icon="/icons/agent.svg"
                factoryClass="com.localagent.LogToolWindowFactory"/>
    <applicationService serviceImplementation="com.localagent.AgentSettings"/>
    <applicationConfigurable parentId="tools" instance="com.localagent.AgentConfigurable"
                             id="com.localagent.settings" displayName="Yang Coding"/>
    <notificationGroup id="Yang Coding" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action id="LocalAgent.AskSelection" class="com.localagent.AskSelectionAction"
            text="Yang Coding: 선택 영역에 대해 묻기" description="선택한 코드를 로컬 에이전트에 질문">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="meta shift L"/>
    </action>
  </actions>
</idea-plugin>
